# Database
DATABASE_URL=postgresql://yaad:yaad@localhost:5432/yaad

# Redis
REDIS_URL=redis://localhost:6379

# Cultivate API (tech detection)
CULTIVATE_API_URL=http://cultivate-api:3000

# Logging
LOG_LEVEL=info

# Tech detection confidence threshold (0-100)
CONFIDENCE_THRESHOLD=50

# Worker concurrency
WORKER_CONCURRENCY=5
# Optional per-stage overrides; when unset they inherit WORKER_CONCURRENCY.
# SUBDOMAIN_WORKER_CONCURRENCY=5
# HTTPX_WORKER_CONCURRENCY=5
# JS_WORKER_CONCURRENCY=5
# ENDPOINT_WORKER_CONCURRENCY=5
TECH_WORKER_CONCURRENCY=3

# API port
PORT=3000

# ProjectDiscovery Cloud Platform (optional, for enhanced subdomain enumeration)
#PDCP_API_KEY=your_key_here

# Enumeration sources & recursion
CRTSH_ENABLED=true
GAU_ENABLED=true
SUBFINDER_DEEP=true        # subfinder -all -recursive (heavier)
MAX_RECURSION_DEPTH=2

# JS blob storage (MinIO / S3)
STORE_JS_BLOBS=true
DETECT_JS_LIBRARIES=true   # retire.js CVE/library fingerprinting (CPU-heavy)
S3_ENDPOINT=minio:9000
S3_ACCESS_KEY=yaad
S3_SECRET_KEY=yaadyaad
S3_BUCKET=js-blobs
S3_USE_SSL=false
# Max JS file size to download/store, in bytes (10 MB)
JS_MAX_BYTES=10485760

# ----------------------------------------------------------------------------
# LOW-POWER / LIGHT MODE (e.g. Raspberry Pi)
# Nothing above changes the default (full) behaviour. To run lighter, lower the
# concurrency and turn off the heavy stages by overriding these in your .env:
#
#   WORKER_CONCURRENCY=1        # fewer parallel jobs = less CPU/RAM
#   HTTPX_WORKER_CONCURRENCY=2  # selectively raise cheap/high-backlog stages
#   ENDPOINT_WORKER_CONCURRENCY=2
#   TECH_WORKER_CONCURRENCY=1
#   SUBFINDER_DEEP=false        # passive-only, no recursion
#   GAU_ENABLED=false           # skip historical-URL mining
#   MAX_RECURSION_DEPTH=0       # don't recurse on JS-discovered subdomains
#   DETECT_JS_LIBRARIES=false   # skip retire.js (biggest CPU saver)
#   STORE_JS_BLOBS=false        # don't download/store JS bodies (saves disk+net)
#   JS_MAX_BYTES=2097152        # cap JS downloads at 2 MB
#   SCHEDULER_TICK_MS=3600000   # re-scan less often
# ----------------------------------------------------------------------------

# Continuous re-scan scheduler
SCHEDULER_TICK_MS=900000
SCHEDULER_BATCH_SIZE=500
RESCAN_ENUM_INTERVAL_HOURS=168
RESCAN_HTTP_INTERVAL_HOURS=24
