FROM node:20-slim

# Install Chromium dependencies for Puppeteer
RUN apt-get update && apt-get install -y \
    chromium \
    wget \
    gnupg \
    ca-certificates \
    fonts-liberation \
    libappindicator3-1 \
    libasound2 \
    libatk-bridge2.0-0 \
    libatk1.0-0 \
    libcairo2 \
    libcups2 \
    libdbus-1-3 \
    libexpat1 \
    libfontconfig1 \
    libgbm1 \
    libgcc1 \
    libglib2.0-0 \
    libgtk-3-0 \
    libnspr4 \
    libnss3 \
    libpango-1.0-0 \
    libpangocairo-1.0-0 \
    libstdc++6 \
    libx11-6 \
    libx11-xcb1 \
    libxcb1 \
    libxcomposite1 \
    libxcursor1 \
    libxdamage1 \
    libxext6 \
    libxfixes3 \
    libxi6 \
    libxrandr2 \
    libxrender1 \
    libxss1 \
    libxtst6 \
    lsb-release \
    xdg-utils \
    git \
    --no-install-recommends && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

ARG CULTIVATE_COMMIT=8b88d55dbf80ed9dd6bd2c2bc5cf0239dc1a668f
ARG WAPPALYZER_DATA_COMMIT=5e7c47b1d441ded0bd476b252261e87634349f96

ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true

# Detect Chromium path (handles both chromium and chromium-browser on ARM)
RUN which chromium || which chromium-browser || echo "chromium not found"
RUN ln -sf $(which chromium-browser 2>/dev/null || which chromium) /usr/bin/chromium 2>/dev/null || true
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
ENV CHROMIUM_BIN=/usr/bin/chromium
ENV PUPPETEER_MAX_TIMEOUT=45000

RUN git clone https://github.com/kapeka0/cultivate-api.git . && \
    git checkout --detach "$CULTIVATE_COMMIT"

RUN git clone --filter=blob:none https://github.com/enthec/webappanalyzer.git /tmp/webappanalyzer && \
    git -C /tmp/webappanalyzer checkout --detach "$WAPPALYZER_DATA_COMMIT" && \
    WAPPALYZER_DATA_REVISION="$WAPPALYZER_DATA_COMMIT" node scripts/install-wappalyzer-data.js /tmp/webappanalyzer /app && \
    rm -rf /tmp/webappanalyzer

RUN npm install --omit=dev
RUN npm test && npm run test:corpus

ENV NODE_ENV=production
ENV PORT=3000
ENV WAPPALYZER_DATA_REVISION=${WAPPALYZER_DATA_COMMIT}

EXPOSE 3000

HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=4 \
  CMD wget -qO- http://localhost:3000/health >/dev/null || exit 1

STOPSIGNAL SIGTERM

CMD ["node", "api.js"]
