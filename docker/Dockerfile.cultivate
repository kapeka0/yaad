FROM node:20-slim

# Install Chromium dependencies for Puppeteer
RUN apt-get update && apt-get install -y \
    chromium \
    wget \
    gnupg \
    ca-certificates \
    fonts-liberation \
    libappindicator3-1 \
    libasound2 \
    libatk-bridge2.0-0 \
    libatk1.0-0 \
    libcairo2 \
    libcups2 \
    libdbus-1-3 \
    libexpat1 \
    libfontconfig1 \
    libgbm1 \
    libgcc1 \
    libglib2.0-0 \
    libgtk-3-0 \
    libnspr4 \
    libnss3 \
    libpango-1.0-0 \
    libpangocairo-1.0-0 \
    libstdc++6 \
    libx11-6 \
    libx11-xcb1 \
    libxcb1 \
    libxcomposite1 \
    libxcursor1 \
    libxdamage1 \
    libxext6 \
    libxfixes3 \
    libxi6 \
    libxrandr2 \
    libxrender1 \
    libxss1 \
    libxtst6 \
    lsb-release \
    xdg-utils \
    git \
    --no-install-recommends && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

ARG CULTIVATE_COMMIT=42754ee2490d4425b117a6ea2e251460496974cc

ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true

# Detect Chromium path (handles both chromium and chromium-browser on ARM)
RUN which chromium || which chromium-browser || echo "chromium not found"
RUN ln -sf $(which chromium-browser 2>/dev/null || which chromium) /usr/bin/chromium 2>/dev/null || true
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
ENV CHROMIUM_BIN=/usr/bin/chromium
ENV PUPPETEER_MAX_TIMEOUT=45000

RUN git clone https://github.com/kapeka0/cultivate-api.git . && \
    git checkout --detach "$CULTIVATE_COMMIT"

# Cultivate only destroys Wappalyzer on the success path. Always close Chromium
# after timeouts/errors as well, otherwise long-running workers leak processes.
COPY docker/cultivate-api-cleanup.patch /tmp/cultivate-api-cleanup.patch
RUN git apply /tmp/cultivate-api-cleanup.patch && \
    rm /tmp/cultivate-api-cleanup.patch

RUN npm install --omit=dev

ENV NODE_ENV=production
ENV PORT=3000

EXPOSE 3000

HEALTHCHECK --interval=15s --timeout=3s --start-period=20s --retries=2 \
  CMD wget -qO- http://localhost:3000/health >/dev/null || exit 1

STOPSIGNAL SIGTERM

CMD ["node", "api.js"]
