FROM node:20-slim

# Install Chromium dependencies for Puppeteer
RUN apt-get update && apt-get install -y \
    chromium \
    wget \
    gnupg \
    ca-certificates \
    fonts-liberation \
    libappindicator3-1 \
    libasound2 \
    libatk-bridge2.0-0 \
    libatk1.0-0 \
    libcairo2 \
    libcups2 \
    libdbus-1-3 \
    libexpat1 \
    libfontconfig1 \
    libgbm1 \
    libgcc1 \
    libglib2.0-0 \
    libgtk-3-0 \
    libnspr4 \
    libnss3 \
    libpango-1.0-0 \
    libpangocairo-1.0-0 \
    libstdc++6 \
    libx11-6 \
    libx11-xcb1 \
    libxcb1 \
    libxcomposite1 \
    libxcursor1 \
    libxdamage1 \
    libxext6 \
    libxfixes3 \
    libxi6 \
    libxrandr2 \
    libxrender1 \
    libxss1 \
    libxtst6 \
    lsb-release \
    xdg-utils \
    git \
    --no-install-recommends && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
ENV PUPPETEER_LAUNCH_ARGS="--no-sandbox --disable-dev-shm-usage --disable-gpu"

# Detect Chromium path (handles both chromium and chromium-browser on ARM)
RUN which chromium || which chromium-browser || echo "chromium not found"
RUN ln -sf $(which chromium-browser 2>/dev/null || which chromium) /usr/bin/chromium 2>/dev/null || true
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

RUN git clone https://github.com/kapeka0/cultivate-api.git . && \
    npm install && \
    find . -name "*.js" -not -path "*/node_modules/*" | \
      xargs grep -l "puppeteer\.launch\|browser\.launch" 2>/dev/null | \
      xargs sed -i "s/puppeteer\.launch({/puppeteer.launch({ args: ['--no-sandbox','--disable-dev-shm-usage','--disable-gpu'],/g" 2>/dev/null || true && \
    find . -name "*.js" -not -path "*/node_modules/*" | \
      xargs grep -l "puppeteer\.launch\|browser\.launch" 2>/dev/null | \
      xargs sed -i "s/puppeteer\.launch()/puppeteer.launch({ args: ['--no-sandbox','--disable-dev-shm-usage','--disable-gpu'] })/g" 2>/dev/null || true

ENV PORT=3000

EXPOSE 3000

CMD ["npm", "start"]
