+}
+
+function signalProcesses(pids, signal) {
+  pids.forEach((pid) => {
+    try {
+      process.kill(pid, signal);
+    } catch {
+      // Best effort: the process may already have exited. A later health
+      // check recycles the container if a browser cannot be reaped.
+    }
+  });
+}
+
+async function cleanupLocalChromium(baseline = new Set()) {
+  const leakedPids = () =>
+    listLocalChromiumPids().filter((pid) => !baseline.has(pid));
+
+  let pids = leakedPids();
+
+  if (!pids.length) {
+    return [];
+  }
+
+  signalProcesses(pids, "SIGTERM");
+  await sleep(250);
+
+  pids = leakedPids();
+  signalProcesses(pids, "SIGKILL");
+  await sleep(100);
+
+  return leakedPids();
+}
